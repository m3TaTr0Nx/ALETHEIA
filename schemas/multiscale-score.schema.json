{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/m3TaTr0Nx/ALETHEIA/schemas/multiscale-score.schema.json",
  "title":"Aletheia Multiscale Structural Similarity Receipt",
  "type":"object",
  "required":["schema","leftGraphId","rightGraphId","overall","scaleScores","components","semanticIdentity"],
  "properties":{
    "schema":{"const":"aletheia.multiscale-graph-score.v1"},
    "leftGraphId":{"type":"string"},
    "rightGraphId":{"type":"string"},
    "overall":{"type":"number","minimum":0,"maximum":1},
    "scaleScores":{
      "type":"object",
      "required":["passage","proposition","edge"],
      "properties":{
        "passage":{"type":"number","minimum":0,"maximum":1},
        "proposition":{"type":"number","minimum":0,"maximum":1},
        "edge":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "components":{"type":"object"},
    "semanticIdentity":{"const":false}
  }
}